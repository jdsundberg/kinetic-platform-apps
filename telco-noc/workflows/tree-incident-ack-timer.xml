<tree schema_version="1.0">
  <sourceName>Kinetic Request CE</sourceName>
  <sourceGroup>GUID</sourceGroup>
  <type>Tree</type>
  <status>Active</status>
  <taskTree builder_version="" schema_version="1.0" version="1">
    <name>Ack Timer Escalation</name><author></author><notes></notes>
    <lastID>5</lastID>
    <request>
    <task definition_id="system_start_v1" id="start" name="Start" x="60" y="40">
      <version>1</version><configured>true</configured><defers>false</defers><deferrable>false</deferrable><visible>false</visible>
      <parameters></parameters>
      <messages><message type="Complete"></message></messages>
      <dependents><task label="New incident?" type="Complete" value="@values['State'] == 'New'">system_wait_v1_1</task></dependents>
    </task>
    <task definition_id="system_wait_v1" id="system_wait_v1_1" name="Wait 3 min for acknowledgement" x="60" y="150">
      <version>1</version><configured>true</configured><defers>true</defers><deferrable>true</deferrable><visible>false</visible>
      <parameters><parameter id="Time to wait">3</parameter><parameter id="Time unit">Minute</parameter></parameters>
      <messages><message type="Create"></message><message type="Update"></message><message type="Complete"></message></messages>
      <dependents><task label="on wake, re-read incident" type="Complete" value="">kinetic_core_api_connection_v1_2</task></dependents>
    </task>
    <task definition_id="kinetic_core_api_connection_v1" id="kinetic_core_api_connection_v1_2" name="Get Incident" x="60" y="260">
      <version>1</version><configured>true</configured><defers>false</defers><deferrable>false</deferrable><visible>false</visible>
      <parameters><parameter id="error_handling">Error Message</parameter><parameter id="method">GET</parameter><parameter id="path">/app/api/v1/submissions/&lt;%= @submission['Id'] %&gt;?include=values</parameter><parameter id="body"></parameter><parameter id="extra_headers"></parameter></parameters>
      <messages><message type="Complete"></message></messages>
      <dependents><task label="Still New (unacknowledged)?" type="Complete" value="(lambda { require 'json'; JSON.parse(@results['Get Incident']['Response Body'])['submission']['values']['State'] == 'New' }).call">kinetic_core_api_connection_v1_3</task></dependents>
    </task>
    <task definition_id="kinetic_core_api_connection_v1" id="kinetic_core_api_connection_v1_3" name="Escalate" x="60" y="370">
      <version>1</version><configured>true</configured><defers>false</defers><deferrable>false</deferrable><visible>false</visible>
      <parameters><parameter id="error_handling">Error Message</parameter><parameter id="method">PUT</parameter><parameter id="path">/app/api/v1/submissions/&lt;%= @submission['Id'] %&gt;</parameter><parameter id="body">&lt;%= require 'json'; require 'time'; { 'values' =&gt; { 'Escalation Level' =&gt; '1' } }.to_json %&gt;</parameter><parameter id="extra_headers"></parameter></parameters>
      <messages><message type="Complete"></message></messages>
      <dependents><task label="then log timeline" type="Complete" value="">kinetic_core_api_connection_v1_4</task></dependents>
    </task>
    <task definition_id="kinetic_core_api_connection_v1" id="kinetic_core_api_connection_v1_4" name="Log Escalation" x="60" y="480">
      <version>1</version><configured>true</configured><defers>false</defers><deferrable>false</deferrable><visible>false</visible>
      <parameters><parameter id="error_handling">Error Message</parameter><parameter id="method">POST</parameter><parameter id="path">/app/api/v1/kapps/telco-noc/forms/incident-updates/submissions</parameter><parameter id="body">&lt;%= require 'json'; require 'time'; { 'coreState' =&gt; 'Submitted', 'values' =&gt; { 'Tenant ID' =&gt; @values['Tenant ID'], 'Update ID' =&gt; 'UPD-' + @values['Incident ID'] + '-ACK-ESC', 'Incident ID' =&gt; @values['Incident ID'], 'Update Type' =&gt; 'Escalation', 'At' =&gt; Time.now.utc.iso8601, 'Author' =&gt; 'workflow', 'Actor Type' =&gt; 'Workflow', 'Summary' =&gt; 'Not acknowledged within 3 min — escalated to level 1 (on-call secondary + duty manager).', 'Details' =&gt; { 'timerMinutes' =&gt; 3, 'run' =&gt; @run['Id'] }.to_json, 'Visibility' =&gt; 'Internal', 'Replay Batch' =&gt; @values['Replay Batch'].to_s } }.to_json %&gt;</parameter><parameter id="extra_headers"></parameter></parameters>
      <messages><message type="Complete"></message></messages>
      <dependents><task label="then audit" type="Complete" value="">kinetic_core_api_connection_v1_5</task></dependents>
    </task>
    <task definition_id="kinetic_core_api_connection_v1" id="kinetic_core_api_connection_v1_5" name="Audit Escalation" x="60" y="590">
      <version>1</version><configured>true</configured><defers>false</defers><deferrable>false</deferrable><visible>false</visible>
      <parameters><parameter id="error_handling">Error Message</parameter><parameter id="method">POST</parameter><parameter id="path">/app/api/v1/kapps/telco-noc/forms/audit/submissions</parameter><parameter id="body">&lt;%= require 'json'; require 'time'; { 'coreState' =&gt; 'Submitted', 'values' =&gt; { 'Tenant ID' =&gt; @values['Tenant ID'], 'Audit ID' =&gt; 'AUD-' + @values['Incident ID'] + '-ACK-ESC', 'At' =&gt; Time.now.utc.iso8601, 'Actor' =&gt; 'workflow:' + @run['Id'].to_s, 'Actor Type' =&gt; 'Workflow', 'Action' =&gt; 'incident.escalate.timer', 'Entity Type' =&gt; 'Incident', 'Entity ID' =&gt; @values['Incident ID'], 'After' =&gt; { 'Escalation Level' =&gt; '1' }.to_json, 'Reason' =&gt; 'ack timer expired', 'Request ID' =&gt; 'run-' + @run['Id'].to_s, 'Replay Batch' =&gt; @values['Replay Batch'].to_s } }.to_json %&gt;</parameter><parameter id="extra_headers"></parameter></parameters>
      <messages><message type="Complete"></message></messages>
      <dependents></dependents>
    </task>
    </request>
  </taskTree>
</tree>
