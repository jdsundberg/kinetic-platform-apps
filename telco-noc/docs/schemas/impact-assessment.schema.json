{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noc.example/schemas/impacts.schema.json",
  "title": "Impact assessment row",
  "type": "object",
  "properties": {
    "Tenant ID": {
      "type": "string",
      "description": "Owning tenant. Leading part of every index; enforced by KSL policy + server scoping."
    },
    "Impact ID": {
      "type": "string"
    },
    "Incident ID": {
      "type": "string"
    },
    "Service Instance ID": {
      "type": "string"
    },
    "Subscription ID": {
      "type": "string"
    },
    "Account ID": {
      "type": "string"
    },
    "Account Name": {
      "type": "string"
    },
    "Segment": {
      "type": "string"
    },
    "Public Safety": {
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ]
    },
    "Impact Class": {
      "type": "string",
      "enum": [
        "Confirmed",
        "Inferred",
        "Potential"
      ]
    },
    "Basis": {
      "type": "string"
    },
    "Path": {
      "type": "string",
      "description": "Resource IDs from root to service"
    },
    "Topology As Of": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC ISO-8601 with Z"
    },
    "Confidence": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$"
    },
    "SLA ID": {
      "type": "string"
    },
    "Impact Started At": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC ISO-8601 with Z"
    },
    "Impact Ended At": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC ISO-8601 with Z"
    },
    "Minutes Impacted": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$"
    },
    "SLA Exposure USD": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?$"
    },
    "SLA Breach At": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC ISO-8601 with Z"
    },
    "Recovery State": {
      "type": "string",
      "enum": [
        "Impacted",
        "Network Restored",
        "Service Verified",
        "Verification Failed"
      ]
    },
    "Verified At": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC ISO-8601 with Z"
    },
    "Verification Evidence": {
      "type": "string"
    },
    "Replay Batch": {
      "type": "string"
    }
  },
  "required": [
    "Tenant ID",
    "Impact ID",
    "Incident ID",
    "Service Instance ID",
    "Impact Class",
    "Basis",
    "Topology As Of"
  ],
  "additionalProperties": false,
  "description": "Kinetic submission values for form impacts (all values are strings on the wire). Schema version 1.0."
}