{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noc.example/schemas/ingest-response.schema.json",
  "title": "ingest-event response",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "accepted",
        "duplicate",
        "rejected"
      ]
    },
    "kind": {
      "enum": [
        "new",
        "repeat",
        "clear",
        "orphan-clear",
        "duplicate",
        "invalid",
        "unscoped"
      ]
    },
    "rawId": {
      "type": "string"
    },
    "alarmId": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    },
    "resourceId": {
      "type": "string"
    },
    "resourceMatch": {
      "type": "string",
      "enum": [
        "Exact",
        "Alias",
        "Unmatched"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "Critical",
        "Major",
        "Minor",
        "Warning",
        "Indeterminate",
        "Cleared"
      ]
    },
    "late": {
      "type": "boolean"
    },
    "clockSkew": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status"
  ],
  "additionalProperties": false
}